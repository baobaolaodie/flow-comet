{
  "schemaVersion": 1,
  "kind": "workflow-kernel",
  "name": "flow-comet",
  "goal": "flow-kit 9 阶段工作流 + 自动状态管理。工件直接读写 .specs/<change-id>/。",
  "nodes": [
    {
      "id": "open",
      "label": "Open",
      "kind": "control",
      "responsibility": "CHANGE 反问 + REQUIREMENT 需求分析。生成 CHANGE.md 和 REQUIREMENT.md。",
      "implementation": {
        "skill": "flow-comet-open",
        "operation": "require",
        "scope": "main",
        "enforcement": "guarded"
      },
      "operations": [
        "require",
        "augment"
      ],
      "requiredSkillCalls": [
        {
          "skill": "flow-comet-change",
          "operation": "require",
          "scope": "main",
          "enforcement": "guarded",
          "reason": "CHANGE 反问协议"
        },
        {
          "skill": "flow-comet-requirement",
          "operation": "require",
          "scope": "main",
          "enforcement": "guarded",
          "reason": "REQUIREMENT 需求分析"
        }
      ],
      "outputSchemas": [
        "flowkit.intake.v1"
      ],
      "guardrails": [
        {
          "id": "intake-artifacts",
          "label": "CHANGE.md + REQUIREMENT.md exist",
          "validation": "artifact-exists"
        }
      ],
      "augmentations": [],
      "satisfies": [],
      "disabled": false
    },
    {
      "id": "design",
      "label": "Design",
      "kind": "control",
      "responsibility": "技术栈选型 + ADR + 数据流。生成 DESIGN.md。",
      "implementation": {
        "skill": "flow-comet-design",
        "operation": "require",
        "scope": "main",
        "enforcement": "guarded"
      },
      "operations": [
        "require",
        "augment",
        "override"
      ],
      "requiredSkillCalls": [
        {
          "skill": "flow-comet-design",
          "operation": "require",
          "scope": "main",
          "enforcement": "guarded",
          "reason": "技术栈选型 + ADR"
        },
        {
          "skill": "flow-comet-ui-design",
          "operation": "require",
          "scope": "main",
          "enforcement": "guarded",
          "reason": "UI-DESIGN（仅前端）"
        }
      ],
      "outputSchemas": [
        "flowkit.design.v1"
      ],
      "guardrails": [
        {
          "id": "design-artifacts",
          "label": "DESIGN.md exists",
          "validation": "artifact-exists"
        }
      ],
      "augmentations": [],
      "satisfies": [],
      "disabled": false
    },
    {
      "id": "plan",
      "label": "Plan",
      "kind": "control",
      "responsibility": "拆原子任务（XML 格式）+ 波次划分。生成 TASK.md。",
      "implementation": {
        "skill": "flow-comet-task",
        "operation": "require",
        "scope": "main",
        "enforcement": "guarded"
      },
      "operations": [
        "require",
        "augment",
        "override"
      ],
      "requiredSkillCalls": [
        {
          "skill": "flow-comet-task",
          "operation": "require",
          "scope": "main",
          "enforcement": "guarded",
          "reason": "拆原子任务"
        }
      ],
      "outputSchemas": [
        "flowkit.plan.v1"
      ],
      "guardrails": [
        {
          "id": "plan-artifacts",
          "label": "TASK.md exists",
          "validation": "artifact-exists"
        }
      ],
      "augmentations": [],
      "satisfies": [],
      "disabled": false
    },
    {
      "id": "execute",
      "label": "Execute",
      "kind": "control",
      "responsibility": "按 TASK.md 逐任务执行：TDD + 6 维自查 + LESSONS 扫描 + diff 边界 verify。",
      "implementation": {
        "skill": "flow-comet-execute",
        "operation": "require",
        "scope": "main",
        "enforcement": "guarded"
      },
      "operations": [
        "require",
        "augment"
      ],
      "requiredSkillCalls": [
        {
          "skill": "flow-comet-dev",
          "operation": "require",
          "scope": "main",
          "enforcement": "guarded",
          "reason": "TDD + 6 维自查 + R4.5 + R4.6"
        }
      ],
      "outputSchemas": [
        "flowkit.execution.v1"
      ],
      "guardrails": [
        {
          "id": "build-evidence",
          "label": "SUMMARY.md produced",
          "validation": "artifact-exists"
        }
      ],
      "augmentations": [],
      "satisfies": [],
      "disabled": false
    },
    {
      "id": "subagent-execute",
      "label": "Subagent Execute",
      "kind": "handoff",
      "responsibility": "委托 [P] 并行任务给子代理，要求加载 flow-comet-dev 并回传 evidence。",
      "implementation": {
        "skill": "flow-comet-subagent-execute",
        "operation": "require",
        "scope": "main",
        "enforcement": "guarded"
      },
      "operations": [
        "require",
        "augment"
      ],
      "requiredSkillCalls": [
        {
          "skill": "flow-comet-dev",
          "operation": "require",
          "scope": "handoff",
          "enforcement": "handoff-guarded",
          "reason": "子代理加载 DEV 规则并回传 evidence"
        }
      ],
      "outputSchemas": [
        "flowkit.handoff.v1"
      ],
      "guardrails": [
        {
          "id": "handoff-evidence",
          "label": "Handoff evidence recorded",
          "validation": "evidence-only"
        }
      ],
      "augmentations": [],
      "satisfies": [],
      "disabled": false
    },
    {
      "id": "review",
      "label": "Review",
      "kind": "control",
      "responsibility": "4 轮审查（spec 合规 + 代码质量 + UI 视觉 + 可选）。生成 REVIEW.md。",
      "implementation": {
        "skill": "flow-comet-review",
        "operation": "require",
        "scope": "main",
        "enforcement": "guarded"
      },
      "operations": [
        "require",
        "augment"
      ],
      "requiredSkillCalls": [
        {
          "skill": "flow-comet-review",
          "operation": "require",
          "scope": "main",
          "enforcement": "guarded",
          "reason": "3 轮审查"
        },
        {
          "skill": "flow-comet-test",
          "operation": "require",
          "scope": "main",
          "enforcement": "guarded",
          "reason": "测试金字塔完整性"
        }
      ],
      "outputSchemas": [
        "flowkit.review.v1"
      ],
      "guardrails": [
        {
          "id": "review-evidence",
          "label": "REVIEW.md exists",
          "validation": "artifact-exists"
        }
      ],
      "augmentations": [],
      "satisfies": [],
      "disabled": false
    },
    {
      "id": "verify",
      "label": "Verify",
      "kind": "control",
      "responsibility": "集成验证 + UAT + 失败诊断（≤3 轮）。生成 TEST.md + UAT.md。",
      "implementation": {
        "skill": "flow-comet-verify",
        "operation": "require",
        "scope": "main",
        "enforcement": "guarded"
      },
      "operations": [
        "require",
        "augment"
      ],
      "requiredSkillCalls": [
        {
          "skill": "flow-comet-integration",
          "operation": "require",
          "scope": "main",
          "enforcement": "guarded",
          "reason": "集成验证 + UAT + LESSONS 提名"
        }
      ],
      "outputSchemas": [
        "flowkit.verify.v1"
      ],
      "guardrails": [
        {
          "id": "verify-evidence",
          "label": "TEST.md or UAT.md exists",
          "validation": "artifact-exists"
        }
      ],
      "augmentations": [],
      "satisfies": [],
      "disabled": false
    },
    {
      "id": "archive",
      "label": "Archive",
      "kind": "control",
      "responsibility": "LESSONS 提名 + 归档到 .specs/archive/ + CHANGELOG 更新。",
      "implementation": {
        "skill": "flow-comet-archive",
        "operation": "require",
        "scope": "main",
        "enforcement": "guarded"
      },
      "operations": [
        "require",
        "augment"
      ],
      "requiredSkillCalls": [
        {
          "skill": "flow-comet-integration",
          "operation": "require",
          "scope": "main",
          "enforcement": "guarded",
          "reason": "归档 + LESSONS"
        }
      ],
      "outputSchemas": [
        "flowkit.archive.v1"
      ],
      "guardrails": [
        {
          "id": "archive-evidence",
          "label": "Archive completed",
          "validation": "state-transition"
        }
      ],
      "augmentations": [],
      "satisfies": [],
      "disabled": false
    }
  ],
  "edges": [
    {
      "from": "open",
      "to": "design",
      "condition": "success"
    },
    {
      "from": "open",
      "to": "open",
      "condition": "failure"
    },
    {
      "from": "open",
      "to": "open",
      "condition": "pause"
    },
    {
      "from": "design",
      "to": "plan",
      "condition": "success"
    },
    {
      "from": "design",
      "to": "design",
      "condition": "failure"
    },
    {
      "from": "design",
      "to": "design",
      "condition": "pause"
    },
    {
      "from": "plan",
      "to": "execute",
      "condition": "success"
    },
    {
      "from": "plan",
      "to": "plan",
      "condition": "failure"
    },
    {
      "from": "plan",
      "to": "plan",
      "condition": "pause"
    },
    {
      "from": "execute",
      "to": "subagent-execute",
      "condition": "success"
    },
    {
      "from": "execute",
      "to": "execute",
      "condition": "failure"
    },
    {
      "from": "execute",
      "to": "execute",
      "condition": "pause"
    },
    {
      "from": "subagent-execute",
      "to": "review",
      "condition": "success"
    },
    {
      "from": "subagent-execute",
      "to": "subagent-execute",
      "condition": "failure"
    },
    {
      "from": "subagent-execute",
      "to": "subagent-execute",
      "condition": "pause"
    },
    {
      "from": "review",
      "to": "verify",
      "condition": "success"
    },
    {
      "from": "review",
      "to": "review",
      "condition": "failure"
    },
    {
      "from": "review",
      "to": "review",
      "condition": "pause"
    },
    {
      "from": "verify",
      "to": "archive",
      "condition": "success"
    },
    {
      "from": "verify",
      "to": "verify",
      "condition": "failure"
    },
    {
      "from": "verify",
      "to": "verify",
      "condition": "pause"
    },
    {
      "from": "archive",
      "to": null,
      "condition": "success"
    },
    {
      "from": "archive",
      "to": "archive",
      "condition": "failure"
    },
    {
      "from": "archive",
      "to": "archive",
      "condition": "pause"
    }
  ],
  "outputSchemas": [
    {
      "id": "flowkit.intake.v1",
      "description": "CHANGE.md + REQUIREMENT.md",
      "artifacts": [
        {
          "id": "change-doc",
          "kind": "file",
          "required": true,
          "paths": [
            "<change-id>/CHANGE.md"
          ],
          "pathBase": "specs-root"
        },
        {
          "id": "requirement-doc",
          "kind": "file",
          "required": true,
          "paths": [
            "<change-id>/REQUIREMENT.md"
          ],
          "pathBase": "specs-root"
        }
      ],
      "evidence": [
        {
          "id": "intake-summary",
          "required": true
        }
      ]
    },
    {
      "id": "flowkit.design.v1",
      "description": "DESIGN.md",
      "artifacts": [
        {
          "id": "design-doc",
          "kind": "file",
          "required": true,
          "paths": [
            "<change-id>/DESIGN.md",
            "<change-id>/DESIGN-lite.md"
          ],
          "pathBase": "specs-root"
        }
      ],
      "evidence": [
        {
          "id": "design-summary",
          "required": true
        }
      ]
    },
    {
      "id": "flowkit.plan.v1",
      "description": "TASK.md",
      "artifacts": [
        {
          "id": "task-plan",
          "kind": "file",
          "required": true,
          "paths": [
            "<change-id>/TASK.md"
          ],
          "pathBase": "specs-root"
        }
      ],
      "evidence": [
        {
          "id": "plan-summary",
          "required": true
        }
      ]
    },
    {
      "id": "flowkit.execution.v1",
      "description": "SUMMARY.md per task",
      "artifacts": [
        {
          "id": "task-summaries",
          "kind": "file",
          "required": true,
          "paths": [
            "<change-id>/*-SUMMARY.md"
          ],
          "pathBase": "specs-root"
        }
      ],
      "evidence": [
        {
          "id": "implementation-summary",
          "required": true
        }
      ]
    },
    {
      "id": "flowkit.handoff.v1",
      "description": "Subagent handoff",
      "artifacts": [],
      "evidence": [
        {
          "id": "handoff-request",
          "required": true
        },
        {
          "id": "handoff-result",
          "required": true
        }
      ]
    },
    {
      "id": "flowkit.review.v1",
      "description": "REVIEW.md",
      "artifacts": [
        {
          "id": "review-doc",
          "kind": "file",
          "required": true,
          "paths": [
            "<change-id>/REVIEW.md"
          ],
          "pathBase": "specs-root"
        }
      ],
      "evidence": [
        {
          "id": "review-summary",
          "required": true
        }
      ]
    },
    {
      "id": "flowkit.verify.v1",
      "description": "TEST.md + UAT.md",
      "artifacts": [
        {
          "id": "test-doc",
          "kind": "file",
          "required": true,
          "paths": [
            "<change-id>/TEST.md"
          ],
          "pathBase": "specs-root"
        },
        {
          "id": "uat-doc",
          "kind": "file",
          "required": true,
          "paths": [
            "<change-id>/UAT.md"
          ],
          "pathBase": "specs-root"
        }
      ],
      "evidence": [
        {
          "id": "verification-result",
          "required": true
        }
      ]
    },
    {
      "id": "flowkit.archive.v1",
      "description": "Archive",
      "artifacts": [
        {
          "id": "archive-dir",
          "kind": "directory",
          "required": true,
          "paths": [
            "archive/<date>-<change-id>/"
          ],
          "pathBase": "specs-root"
        }
      ],
      "evidence": [
        {
          "id": "archive-summary",
          "required": true
        }
      ]
    }
  ],
  "state": {
    "kind": "workflow-run",
    "statePath": ".comet/flow-comet-state.json",
    "currentNodeField": "currentNode",
    "completedNodesField": "completedNodes",
    "evidenceField": "evidence"
  },
  "evals": [
    {
      "id": "workflow-route-conformance",
      "expectedNodeOrder": [
        "open",
        "design",
        "plan",
        "execute",
        "subagent-execute",
        "review",
        "verify",
        "archive"
      ],
      "requiredOutputSchemas": [
        "flowkit.intake.v1",
        "flowkit.design.v1",
        "flowkit.plan.v1",
        "flowkit.execution.v1",
        "flowkit.handoff.v1",
        "flowkit.review.v1",
        "flowkit.verify.v1",
        "flowkit.archive.v1"
      ]
    }
  ]
}