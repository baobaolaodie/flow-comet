#!/usr/bin/env node
/**
 * commit-msg hook — 提交消息含内部词(过程代号)时阻止提交(本项目仓库约定)
 *
 * 由 scripts/install-commit-hook.mjs 通过 core.hooksPath 生效(hook 文件在仓库内,随 pull 更新)。
 * 检测第一行(subject)——内部词进入提交历史后极难清理(历史重写成本高),源头拦截成本最低。
 */
import fs from 'node:fs';
import { BANNED } from './internal-codes.mjs';

const msgFile = process.argv[2];
if (!msgFile) process.exit(0);
const subject = fs.readFileSync(msgFile, 'utf8').split('\n')[0];
const m = subject.match(BANNED);
if (m) {
  console.error(
    `提交被拒绝:提交信息含内部词(过程代号)「${m[0]}」——请用平实描述,` +
      `如:fix: verify 超时时间可配置`
  );
  process.exit(1);
}
